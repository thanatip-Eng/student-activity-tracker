# Copy to functions/.env and fill in. DO NOT commit the real .env.
# These three values must match what you enter in Canvas (+ App).

# A key you invent (any string). Entered in Canvas as "Consumer Key".
LTI_CONSUMER_KEY=cmu-eng-tracker

# A long random secret you invent. Entered in Canvas as "Shared Secret".
# Generate one, e.g.:  openssl rand -hex 24
LTI_CONSUMER_SECRET=replace-with-a-long-random-secret

# The EXACT Launch URL registered in Canvas (must match character-for-character).
LTI_LAUNCH_URL=https://student-activity-tracker-13eb5.web.app/lti/launch
